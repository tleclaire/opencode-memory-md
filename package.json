{
  "name": "@tleclaire/opencode-memory-md",
  "version": "2.0.0",
  "description": "Markdown-based memory plugin for OpenCode — fork of @zhafron/opencode-memory-md with an OpenCode v2 plugin entrypoint",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky"
  },
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "markdown"
  ],
  "author": "zhafron",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tleclaire/opencode-memory-md.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@huggingface/transformers": "4.0.0-next.4",
    "@opencode-ai/plugin": "^1.18.30",
    "vectra": "^0.12.3"
  },
  "overrides": {
    "onnxruntime-node": "1.23.2"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.9",
    "@types/bun": "^1.3.8",
    "@types/node": "^22.19.11",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "opencode": {
    "type": "plugin"
  },
  "files": [
    "dist"
  ]
}
